{
    "name": "components",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "generate-icons": "svg-generator",
        "build-lib": "ng-packagr -p sp-components/package.json"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "~8.2.14",
        "@angular/common": "~8.2.14",
        "@angular/compiler": "~8.2.14",
        "@angular/core": "~8.2.14",
        "@angular/forms": "~8.2.14",
        "@angular/platform-browser": "~8.2.14",
        "@angular/platform-browser-dynamic": "~8.2.14",
        "@angular/router": "~8.2.14",
        "@ngneat/svg-icon": "^2.3.0",
        "angular-svg-icon": "^11.2.0",
        "chart.js": "^2.9.4",
        "ng-zorro-antd": "^8.5.2",
        "ng2-charts": "^2.4.2",
        "rxjs": "~6.4.0",
        "sp-components": "file:sp-components",
        "svg-to-ts": "^6.0.0",
        "tslib": "^1.10.0",
        "zone.js": "~0.9.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~0.803.25",
        "@angular/cdk": "^8.2.3",
        "@angular/cli": "~8.3.25",
        "@angular/compiler-cli": "~8.2.14",
        "@angular/language-service": "~8.2.14",
        "@ngneat/svg-generator": "^1.0.0",
        "@types/jasmine": "~3.3.8",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "~8.9.4",
        "codelyzer": "^5.0.0",
        "jasmine-core": "~3.4.0",
        "jasmine-spec-reporter": "~4.2.1",
        "karma": "~4.1.0",
        "karma-chrome-launcher": "~2.2.0",
        "karma-coverage-istanbul-reporter": "~2.0.1",
        "karma-jasmine": "~2.0.1",
        "karma-jasmine-html-reporter": "^1.4.0",
        "ng-packagr": "^11.2.4",
        "protractor": "~5.4.0",
        "ts-node": "~7.0.0",
        "tsickle": "^0.39.1",
        "tslint": "~5.15.0",
        "typescript": "~3.5.3"
    },
    "svgGenerator": {
        "outputPath": "./src/app/svg",
        "prefix": "app",
        "srcPath": "./src/assets/svg",
        "outputDirectory": "./src/app",
        "svgoConfig": {
            "plugins": [
                {
                    "removeDimensions": true,
                    "cleanupAttrs": true
                }
            ]
        }
    }
}
