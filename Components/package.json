{
  "name": "components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "generate-icons": "svg-generator",
    "build-lib": "ng-packagr -p sp-components/package.json",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "storybook": "yarn docs:json && start-storybook -p 6006",
    "build-storybook": "yarn docs:json && build-storybook",
    "storybook-chache": "start-storybook -p 6006 --no-manager-cache"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^11.2.13",
    "@angular-devkit/schematics": "^11.2.13",
    "@angular/animations": "^11.0.4",
    "@angular/common": "^11.0.4",
    "@angular/compiler": "^11.0.4",
    "@angular/core": "^11.0.4",
    "@angular/forms": "^11.0.4",
    "@angular/platform-browser": "^11.0.4",
    "@angular/platform-browser-dynamic": "^11.0.4",
    "@angular/router": "^11.0.4",
    "@ngneat/svg-icon": "^3.2.0",
    "@schematics/angular": "^11.2.13",
    "@schematics/update": "^0.1102.12",
    "angular-svg-icon": "^11.2.0",
    "chart.js": "^2.9.4",
    "ng-zorro-antd": "^11.4.1",
    "ng2-charts": "^2.4.2",
    "postcss": "^8.2.15",
    "rxjs": "~6.6.7",
    "sp-components": "file:sp-components",
    "svg-to-ts": "^6.0.0",
    "tslib": "^2.2.0",
    "typescript": "~4.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^11.1.1",
    "@angular-devkit/build-angular": "^0.1102.13",
    "@angular/cdk": "^11.0.4",
    "@angular/cli": "^11.0.4",
    "@angular/compiler-cli": "~11.0.4",
    "@angular/language-service": "^11.0.4",
    "@compodoc/compodoc": "^1.1.11",
    "@ngneat/svg-generator": "^1.0.0",
    "@storybook/addon-essentials": "^6.2.9",
    "@storybook/addon-links": "^6.2.9",
    "@storybook/addons": "^6.2.9",
    "@storybook/angular": "^6.2.9",
    "@storybook/cli": "^6.2.9",
    "@storybook/theming": "^6.2.9",
    "@types/jasmine": "^3.6.11",
    "@types/jasminewd2": "^2.0.9",
    "@types/node": "^11.15.54",
    "babel-loader": "^8.2.2",
    "codelyzer": "^6.0.2",
    "css-loader": "^5.2.6",
    "html-webpack-plugin": "^5.3.1",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "^6.3.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.6.0",
    "less": "^4.1.1",
    "less-loader": "^9.0.0",
    "ng-packagr": "^11.0.0",
    "protractor": "~7.0.0",
    "style-loader": "^2.0.0",
    "ts-loader": "^9.2.2",
    "ts-node": "^10.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.1.0",
    "webpack": "^4.46.0"
  },
  "svgGenerator": {
    "outputPath": "./src/app/svg",
    "prefix": "app",
    "srcPath": "./src/assets/svg",
    "outputDirectory": "./src/app",
    "svgoConfig": {
      "plugins": [
        {
          "removeDimensions": true,
          "cleanupAttrs": true
        }
      ]
    }
  }
}
